# Переменные окружения для shift-Manager

# ==========================================
# DEVELOPMENT ENVIRONMENT
# ==========================================

# API Конфигурация
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000

# Приложение
VITE_APP_NAME=shift-Manager
VITE_APP_VERSION=0.1.0
VITE_NODE_ENV=development

# Feature Flags
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_MOCK_API=true

# Authentication
VITE_AUTH_TOKEN_KEY=shift-manager-token
VITE_AUTH_EXPIRES_IN=24h

# Logging
VITE_LOG_LEVEL=debug

# ==========================================
# PRODUCTION ENVIRONMENT (.env.production)
# ==========================================

# VITE_API_URL=https://api.shift-manager.com
# VITE_WS_URL=wss://api.shift-manager.com
# VITE_APP_VERSION=0.1.0
# VITE_NODE_ENV=production
# VITE_ENABLE_OFFLINE_MODE=true
# VITE_ENABLE_ANALYTICS=true
# VITE_ENABLE_MOCK_API=false
# VITE_LOG_LEVEL=error

# ==========================================
# STAGING ENVIRONMENT (.env.staging)
# ==========================================

# VITE_API_URL=https://staging-api.shift-manager.com
# VITE_WS_URL=wss://staging-api.shift-manager.com
# VITE_APP_VERSION=0.1.0-staging
# VITE_NODE_ENV=staging
# VITE_ENABLE_OFFLINE_MODE=true
# VITE_ENABLE_ANALYTICS=true
# VITE_ENABLE_MOCK_API=false
# VITE_LOG_LEVEL=info
